# 仅用于本地开发。复制为 .env 后可按需修改。
MYSQL_DATABASE=lipu_chat
MYSQL_USER=lipu
MYSQL_PASSWORD=lipu_dev_password
MYSQL_ROOT_PASSWORD=lipu_root_dev_password
MYSQL_PORT=3306

REDIS_PASSWORD=lipu_redis_dev_password
REDIS_PORT=6379

# API / Web
API_PORT=3000
WEB_PORT=8080
PUBLIC_WEB_ORIGIN=http://localhost:8080,http://localhost:5173
JWT_ACCESS_SECRET=change-this-to-a-long-random-string-in-production
ROOM_EMPTY_TTL_SECONDS=300

# OpenAI-compatible 大模型接口。未填写 Key 时自动进入本地 Mock 模式。
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=12000
LLM_MOCK_MODE=true
